# Supabase — survey responses are stored in public.survey_responses
# (create it with supabase/migrations/001_survey_responses.sql).
# Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional, server-only. If set, the API route inserts with this key instead of the
# publishable one. Never prefix it with NEXT_PUBLIC_ and never commit it.
SUPABASE_SECRET_KEY=
