# Supabase. Survey responses are stored in public.survey_responses
# (create it with the files in supabase/migrations/, in order).
# Dashboard → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Recommended, server-only (the `sb_secret_...` key). When set, the API route inserts
# with this key, and migration 004 can then remove the public key's insert access.
# Never prefix it with NEXT_PUBLIC_, never commit it, never paste it anywhere public.
SUPABASE_SECRET_KEY=
